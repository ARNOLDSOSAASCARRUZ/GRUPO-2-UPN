<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.PrincipalController">
    <top>
        <Label text="🌱 Sistema de Reciclaje Comunitario - G2" style="-fx-font-size: 18px; -fx-padding: 10;" />
    </top>
    <center>
        <VBox spacing="10" alignment="CENTER">
            <Button text="Registro de Usuario" onAction="#abrirRegistro" />
            <Button text="Ingreso de Materiales" onAction="#abrirMateriales" />
            <Button text="Estadísticas" onAction="#abrirEstadisticas" />
            <Button text="Reporte" onAction="#abrirReporte" />
            <Button text="Ver Usuarios Registrados" onAction="#abrirUsuarios" />
        </VBox>
    </center>
</BorderPane>