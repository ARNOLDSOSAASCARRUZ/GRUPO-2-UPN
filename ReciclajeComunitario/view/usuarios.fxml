<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.UsuariosController">
    <top>
        <Label text="👥 Usuarios Registrados" style="-fx-font-size: 18px; -fx-padding: 10;" />
    </top>
    <center>
        <TableView fx:id="tablaUsuarios">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" />
                <TableColumn fx:id="colDni" text="DNI" />
                <TableColumn fx:id="colDireccion" text="Dirección" />
                <TableColumn fx:id="colPuntos" text="Puntos" />
            </columns>
        </TableView>
    </center>
</BorderPane>