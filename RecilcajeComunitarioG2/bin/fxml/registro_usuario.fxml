<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="view.RegistroUsuarioView">

    <top>
        <Label text="👤 Registro de Nuevo Usuario"
               styleClass="titulo-principal"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER" styleClass="contenedor-tabla">

            <HBox spacing="10">
                <Label text="Nombre:"/>
                <TextField fx:id="txtNombre" promptText="Ej. Juan Pérez" prefWidth="200"/>
            </HBox>

            <HBox spacing="10">
                <Label text="DNI:"/>
                <TextField fx:id="txtDni" promptText="Ej. 12345678" prefWidth="200"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Dirección:"/>
                <TextField fx:id="txtDireccion" promptText="Ej. Av. Siempre Viva 123" prefWidth="200"/>
            </HBox>

            <Button text="Registrar usuario"
                    onAction="#registrarUsuario"
                    styleClass="button"/>

            <Label fx:id="lblMensaje" text="" styleClass="label"/>
        </VBox>
    </center>
</BorderPane>