<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="view.ReporteView">

    <top>
        <Label text="📄 Reporte General del Sistema"
               styleClass="titulo-principal"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER" styleClass="contenedor-tabla">

            <TableView fx:id="tablaReporte" prefWidth="600" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="150"/>
                    <TableColumn fx:id="colDni" text="DNI" prefWidth="100"/>
                    <TableColumn fx:id="colMaterial" text="Material" prefWidth="150"/>
                    <TableColumn fx:id="colPeso" text="Peso (kg)" prefWidth="100"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                </columns>
            </TableView>

            <Button text="Generar reporte"
                    onAction="#generarReporte"
                    styleClass="button"/>

            <Label fx:id="lblMensaje" text="" styleClass="label"/>
        </VBox>
    </center>
</BorderPane>