<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="view.VerUsuariosView">

    <top>
        <Label text="👥 Usuarios Registrados"
               styleClass="titulo-principal"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER" styleClass="contenedor-tabla">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <TableView fx:id="tablaUsuarios" prefWidth="600" prefHeight="300">
                <columns>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                    <TableColumn fx:id="colDni" text="DNI" prefWidth="100"/>
                    <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="200"/>
                    <TableColumn fx:id="colPuntos" text="Puntos" prefWidth="100"/>
                </columns>
            </TableView>

            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="btnEditarUsuario" text="✏️ Editar Usuario" onAction="#editarUsuario"/>
                <Button fx:id="btnEliminarUsuario" text="🗑️ Eliminar Usuario" onAction="#eliminarUsuario"/>
                <Button fx:id="btnRefrescar" text="🔄 Refrescar Tabla" onAction="#refrescarTabla"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>