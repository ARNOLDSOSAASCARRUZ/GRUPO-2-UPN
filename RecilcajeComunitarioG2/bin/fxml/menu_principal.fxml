<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="view.MenuPrincipalView">

    <top>
        <Label text="🌱 Sistema de Reciclaje Comunitario - G2"
               styleClass="titulo-principal"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="20" alignment="CENTER" styleClass="contenedor-tabla">

            <Button text="Registro de Usuario"
                    onAction="#abrirRegistroUsuario"
                    styleClass="button"/>

            <Button text="Ingreso de Materiales"
                    onAction="#abrirIngresoMaterial"
                    styleClass="button"/>

            <Button text="Estadísticas"
                    onAction="#abrirEstadisticas"
                    styleClass="button"/>

            <Button text="Reporte"
                    onAction="#abrirReporte"
                    styleClass="button"/>

            <Button text="Ver Usuarios Registrados"
                    onAction="#abrirVerUsuarios"
                    styleClass="button"/>

        </VBox>
    </center>
</BorderPane>